# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=naveda_integra.settings.development

# ── Database ─────────────────────────────────────────────────────────────────
# Option A: Single URL (Neon.tech / Render / Heroku — preferred for production)
# DATABASE_URL=postgresql://user:password@ep-cool-cloud-123456.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
#
# Option B: Individual vars (local PostgreSQL — used when DATABASE_URL is not set)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=naveda_integra
# DB_USER=postgres
# DB_PASSWORD=your-db-password-here
# DB_HOST=localhost
# DB_PORT=5432
#
# Option C: Leave everything commented out → development.py defaults to SQLite

# ── Render.com Deployment ────────────────────────────────────────────────────
# RENDER_EXTERNAL_HOSTNAME=naveda-integra.onrender.com   (set automatically by Render)
# CSRF_TRUSTED_ORIGINS=https://naveda-integra.onrender.com
# WEB_CONCURRENCY=4

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ── Backup ───────────────────────────────────────────────────────────────────
# BACKUP_DIR=/tmp/backups
# BACKUP_KEEP_DAYS=7
